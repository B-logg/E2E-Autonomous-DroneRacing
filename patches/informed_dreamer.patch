+# --- SkyDreamer (arXiv:2510.14783) ----------------------------------------
+# Section III-A: size12m, default hyperparameters, replay_context 16,
+# train_ratio 128, slowtar true, replay size 10e6 (= 31 h of flight).
+# Phase 1 of 3; see scripts/train.py for the batch_length / entropy / lr
+# schedule changes at 8M and 13M steps.
+skydreamer:
+  task: skydreamer_inverted_loop
+  batch_length: 64
+  replay_context: 16
+  replay.size: 10e6
+  agent:
+    informed: True
+    imag_loss: {slowtar: True, actsmooth: 0.002}
+    imag_length: 16
+  run: {steps: 17e6, train_ratio: 128, envs: 16}
+  env:
+    skydreamer: {size: 64, max_steps: 2000, use_seed: True}
+
+# Section III-D: the big track needs longer training, a lower train ratio and
+# no symlog on the encoder/decoder.
+skydreamer_big:
+  task: skydreamer_big
+  batch_length: 64
+  replay_context: 16
+  replay.size: 10e6
+  agent:
+    informed: True
+    imag_loss: {slowtar: True, actsmooth: 0.002}
+    imag_length: 16
+    enc.simple.symlog: False
+    dec.simple.symlog: False
+  run: {steps: 35e6, train_ratio: 64, envs: 16}
+  env:
+    skydreamer: {size: 64, max_steps: 4000, use_seed: True}
+
 multicpu:
   batch_size: 12
   jax.mock_devices: 8
