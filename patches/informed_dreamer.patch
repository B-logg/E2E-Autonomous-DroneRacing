@@ -36,8 +36,20 @@ class Agent(embodied.jax.Agent):
     self.config = config
 
     exclude = ('is_first', 'is_last', 'is_terminal', 'reward')
-    enc_space = {k: v for k, v in obs_space.items() if k not in exclude}
-    dec_space = {k: v for k, v in obs_space.items() if k not in exclude}
+    # Informed POMDP (Lambrechts et al. 2024, used by SkyDreamer): keys named
+    # `info_*` are privileged information available at training time only.  The
+    # encoder must never see them; the decoder reconstructs *only* them, which
+    # is what turns the world model into a state and parameter estimator.
+    informed = getattr(config, 'informed', False)
+    is_info = lambda k: k.startswith('info_')
+    enc_space = {
+        k: v for k, v in obs_space.items()
+        if k not in exclude and not (informed and is_info(k))}
+    dec_space = {
+        k: v for k, v in obs_space.items()
+        if k not in exclude and (is_info(k) if informed else True)}
+    assert enc_space, 'encoder has no inputs'
+    assert dec_space, 'decoder has no targets; informed=True needs info_* keys'
     self.enc = {
         'simple': rssm.Encoder,
     }[config.enc.typ](enc_space, **config.enc[config.enc.typ], name='enc')
@@ -123,11 +135,28 @@ class Agent(embodied.jax.Agent):
     if dec_carry:
       dec_carry, dec_entry, recons = self.dec(dec_carry, feat, reset, **kw)
     policy = self.pol(self.feat2tensor(feat), bdims=1)
-    act = sample(policy)
+    if mode == 'eval' and self.config.deterministic_eval:
+      # SkyDreamer II-G: "At inference time and during evaluation, we use the
+      # deterministic version of the policy (sigma_t = 0) to produce even
+      # smoother control."  Stock DreamerV3 accepts `mode` and ignores it, so
+      # without this every evaluation flies a sampled -- i.e. noisier -- policy
+      # than the one the paper reports.
+      act = jax.tree.map(lambda d: d.pred(), policy)
+    else:
+      act = sample(policy)
     out = {}
     out['finite'] = elements.tree.flatdict(jax.tree.map(
         lambda x: jnp.isfinite(x).all(range(1, x.ndim)),
         dict(obs=obs, carry=carry, tokens=tokens, feat=feat, act=act)))
+    if self.config.decode_in_policy:
+      # SkyDreamer's interpretability claim (II-G, Figures 4/5): the decoder
+      # reconstructs privileged state, so running it at policy time exposes
+      # what the world model believes the drone's position, velocity, camera
+      # extrinsics and dynamic parameters currently are.  Off by default --
+      # it costs a decoder pass per step and the training loop never needs it.
+      _, _, policy_recons = self.dec({}, feat, reset, **kw)
+      for key, dist in policy_recons.items():
+        out[f'recon_{key}'] = dist.pred()
     carry = (enc_carry, dyn_carry, dec_carry, act)
     if self.config.replay_context:
       out.update(elements.tree.flatdict(dict(
@@ -389,6 +418,7 @@ def imag_loss(
     horizon=333,
     lam=0.95,
     actent=3e-4,
+    actsmooth=0.0,
     slowreg=1.0,
 ):
   losses = {}
@@ -412,6 +442,24 @@ def imag_loss(
   ents = {k: v.entropy()[:, :-1] for k, v in policy.items()}
   policy_loss = sg(weight[:, :-1]) * -(
       logpi * sg(adv_normed) + actent * sum(ents.values()))
+  if actsmooth:
+    # SkyDreamer II-G: without this the policy converges to bang-bang motor
+    # commands, which are fine in simulation and burn real motors.  Applied to
+    # the policy *mean* only -- penalising the full distribution would fight
+    # the entropy bonus above.
+    # Heads come wrapped in outs.Agg, which has no `.mean`; unwrap it, and
+    # assert rather than silently contributing nothing to the loss.
+    means = []
+    for v in policy.values():
+      inner = getattr(v, 'output', v)
+      if isinstance(inner, embodied.jax.outs.Normal):
+        means.append(inner.mean)
+    assert means, (
+        'actsmooth requires a continuous (Normal) policy head; got '
+        f'{[type(getattr(v, "output", v)).__name__ for v in policy.values()]}')
+    smooth = sum(jnp.square(m[:, 1:] - m[:, :-1]).sum(-1) for m in means)
+    policy_loss = policy_loss + actsmooth * smooth
+    metrics['actsmooth'] = smooth.mean()
   losses['policy'] = policy_loss
 
   voffset, vscale = valnorm(ret, update)
